# Grafana admin (change before first start!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# Telegram receiver for Alertmanager (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=0

# Retention
PROMETHEUS_RETENTION=15d

# Bind address for published ports (127.0.0.1 = local only, put a reverse proxy in front)
BIND_ADDR=127.0.0.1
