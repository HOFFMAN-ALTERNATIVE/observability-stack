# Grafana admin (change before first start!)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# Telegram receiver for Alertmanager (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
# Your chat id (negative for groups)
TELEGRAM_CHAT_ID=123456789

# Optional dead-man's switch: a ping URL from healthchecks.io or a similar service.
# Alertmanager posts the always-firing Watchdog alert there every 5 minutes; if the
# pings stop, that service alerts you. Empty = Watchdog is dropped.
DEADMANS_SWITCH_URL=

# Retention
PROMETHEUS_RETENTION=15d

# Bind address for published ports (127.0.0.1 = local only, put a reverse proxy in front)
BIND_ADDR=127.0.0.1
